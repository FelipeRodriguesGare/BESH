# Database & Redis
BESH_DATABASE_URL=postgresql+asyncpg://besh:besh_password@localhost:5432/batch
BESH_REDIS_URL=redis://localhost:6379/0

# LLM API Configuration
BESH_API_BASE=http://localhost:8000/v1
BESH_API_KEY=dummy-key

# Storage - Local (default)
BESH_STORAGE_BACKEND=local
BESH_UPLOAD_FOLDER=./batch_files

# Storage - S3 (uncomment and configure to use S3)
# BESH_STORAGE_BACKEND=s3
# BESH_S3_BUCKET=your-bucket-name
# BESH_S3_PROFILE=your-aws-profile  # Optional: AWS profile name (uses IAM role by default)
# BESH_S3_REGION=us-east-1          # Optional: AWS region (default: us-east-1)
# BESH_S3_ENDPOINT_URL=              # Optional: Custom S3 endpoint (for MinIO, LocalStack, etc.)
# BESH_S3_PRESIGNED_EXPIRY=3600     # Optional: Presigned URL expiry in seconds (default: 3600)

# Authentication
BESH_BASIC_AUTH_USERNAME=
BESH_BASIC_AUTH_PASSWORD=
BESH_AUTH_API_KEY=

# Workers
BESH_CONCURRENT_REQUESTS_PER_WORKER=64

# Chunking (for large batch files)
BESH_CHUNK_SIZE=10000
BESH_CHUNK_THRESHOLD=50000
BESH_KEEP_CHUNKS=false

# Migrations
BESH_AUTO_MIGRATE=true