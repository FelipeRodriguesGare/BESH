FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies including build tools for package compilation
RUN apt-get update && apt-get install -y \
    curl \
    gcc \
    g++ \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
RUN pip install --upgrade pip

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir redis
RUN pip install --no-cache-dir litellm
RUN pip install --no-cache-dir aiofiles
RUN pip install --no-cache-dir asyncpg

# Copy worker application
COPY worker/ ./worker/
COPY src/models/ ./src/models/

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Health check - improved to check both Redis and worker process
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import redis; r = redis.Redis(host='redis', port=6379); r.ping()" || exit 1

# Run the worker
CMD ["python", "worker/app.py"]
